import numpy as np

def fast_fourier(y, x, l=['B_R', 'B_T', 'B_N', 'B_mag']):
    '''

    This function cuts the data into 12 hr chunks and takes the Fourier
    transform of each chunk, for every component. The last chunk can be
    shorter than 12 hr, so each chunk gets its own frequencies.
    
    Parameters
    ----------
    y : list of arrays, one array of values per component (B_R, B_T, B_N)
    x : array of times in seconds, evenly spaced
    l : list of component names, only used for the printed messages
    
    Returns
    -------
    B : list with one entry per component, each entry is a list of arrays,
        one per chunk, holding the size |F| of the transform
    W : list of arrays, the frequencies (in Hz) of each chunk
    
    Notes
    -----
    
    The mean of each chunk is subtracted before the transform.
    The zero frequency is dropped, so log10 does not give -inf.
    The transform is normalised with norm="ortho".
    Power is made later: power = dx * |F|**2
    
    '''
    
    dx = (x[-1]-x[0])/(len(x)-1)
    w = np.fft.rfftfreq(len(x), dx)
    w = w[1:]
    
    B = []
    p=0
    for coord in y:
        print(f"Transforming {l[p]}")
        b = np.fft.rfft(coord-np.mean(coord), norm="ortho")
        B.append(np.abs(b[1:]))
        p += 1
    
    return (B, w)

def smoothen(x, y, factor=np.sqrt(3)):
    '''

    This function averages y over a window that grows with frequency.
    For each point, the window runs from x/factor to x*factor, so the
    window is always the same size on a log axis.
    
    Parameters
    ----------
    x : array of frequencies (plain, not log), sorted from low to high
    y : array of values to smooth, same length as x
    factor: the window runs from x/factor to x*factor, so it is factor**2
            wide in frequency (np.sqrt(2) for a factor of 2)
    
    Returns
    -------
    list of the smoothed values, same length as y
    
    Notes
    -----
    
    The edges of each window are found with np.searchsorted.
    The sum in each window is c[upper] - c[lower], where c is the running
    total of y with a 0 in front, so every number is only added once.
    Every window has at least 1 point.
    
    '''
    c = np.append(0, np.cumsum(y))
    l_xlim = (x/factor)
    u_xlim = (x*factor)
    l_index = np.searchsorted(x, l_xlim)
    u_index = np.searchsorted(x, u_xlim)
    Y = []
    for i in range(len(x)):
        l = int(l_index[i])
        u = int(u_index[i])
        if u <= l:
            u = l + 1
        mean = (c[u] - c[l]) / (u - l)
        Y.append(mean)
    return Y

def regression_slope(a, b, factor=np.sqrt(10)):
    '''

    This function divides a data set into small section
    then draws a regression line through the small sections.
    and returns the slopes of the regression line as an array.

    Parameters
    ----------
    a : array of a values
    b : array of b values
    factor: ratio of bin size to take the slope over

    Returns
    -------
    array of regression line slope

    Formulae
    --------

    Least squares regression for y = a + b*x

    b = Sxy / Sxx
    a = ybar - b * xbar

    where:
    Sxy = sum(x*y) - (sum(x) * sum(y)) / n
    Sxx = sum(x**2) - (sum(x))**2 / n
    xbar = mean(x), ybar = mean(y), n = number of points

    '''

    w = 10**a                               # plain frequency, only used to find the window edges

    l_alim = (w/factor)
    u_alim = (w*factor)
    l_index = np.searchsorted(w, l_alim)
    u_index = np.searchsorted(w, u_alim)

    XY = np.append(0, np.cumsum(a*b))
    XX = np.append(0, np.cumsum(a*a))
    X = np.append(0, np.cumsum(a))
    Y = np.append(0, np.cumsum(b))

    slopes = []
    for i in range(len(a)):

        l = int(l_index[i])
        u = int(u_index[i])
        if u <= l + 1:                      # a line needs at least 2 points
            u = l + 2
        N = u-l                   # real number of points in the window after clipping
        xy = XY[u]-XY[l]          # sum of a*b inside the window
        xx = XX[u]-XX[l]          # sum of a squared inside the window
        x = X[u]-X[l]             # sum of a inside the window (was a slice before)
        y = Y[u]-Y[l]             # sum of b inside the window (was a slice before)

        Sxy = xy - x*y/N
        Sxx = xx - x**2/N

        m = Sxy/Sxx
        slopes.append(m)

    return np.array(slopes)
